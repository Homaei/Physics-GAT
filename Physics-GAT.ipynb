# --- 3. DATASET AND FEATURE ENGINEERING (PI-Data Representation) ---

class PhysicalConstraintFeatures:
    """
    Generates Physics-Informed (PI) features: normalized violations of
    Mass Balance and Energy Gradient.
    """
    def __init__(self, node_data, pipe_data, graph_adj):
        """
        Initializes with static hydraulic parameters (elevations, pipe lengths/diameters, roughness).
        :param node_data: DataFrame with static node data (e.g., 'Elevation')
        :param pipe_data: DataFrame with static pipe data (e.g., 'Length', 'Diameter', 'C_HW')
        :param graph_adj: Adjacency list/map for graph topology (to find neighbors)
        """
        # Static parameters (Placeholders: Replace with actual C-Town data loading)
        self.elevations = node_data['Elevation'].values
        self.pipe_params = pipe_data[['Length', 'Diameter', 'C_HW']].values
        self.pipe_adj = pipe_data[['StartNode', 'EndNode']].values
        self.adj = graph_adj
        self.node_to_idx = {node: i for i, node in enumerate(node_data.index)}

    def hazen_williams_head_loss(self, Q, L, D, C_HW):
        """
        Calculates theoretical head loss h_L(Q) using the Hazen-Williams formula.
        J is a proportionality constant based on units (e.g., J=4.72 for US units)
        The paper implies a known constant and units, so we use a simplified form.
        :param Q: Flow rate (m3/s or other consistent unit)
        :param L, D, C_HW: Length, Diameter, Roughness Coeff.
        """
        # Hazen-Williams formula structure: h_L = J * L * Q^1.852 / (C_HW^1.852 * D^4.87)
        J = 10.67  # Placeholder for metric units
        Q_abs = torch.abs(Q)
        h_L = J * L * torch.pow(Q_abs, 1.852) / (torch.pow(C_HW, 1.852) * torch.pow(D, 4.87) + EPSILON)
        return h_L * torch.sign(Q) # Apply sign for direction

    def compute_pi_features(self, P_t, Q_t, D_t):
        """
        Computes PI features (phi_mass, phi_energy) at a single time step t.
        :param P_t: Tensor of pressures at time t (N_nodes,)
        :param Q_t: Tensor of pipe flows at time t (N_pipes,)
        :param D_t: Tensor of estimated demands at time t (N_nodes,)
        :return: phi_mass (N_nodes,), phi_energy (N_nodes,)
        """
        N = P_t.shape[0]
        # 1. Mass Balance Violation (Equation 1)
        phi_mass = torch.zeros(N, dtype=P_t.dtype).to(device)
        total_inflow_sum = torch.zeros(N, dtype=P_t.dtype).to(device)

        for i in range(N):
            net_flow = 0.0
            total_inflow = 0.0
            
            # Iterate through all pipes to find flows incident to node i
            for idx, (start_node, end_node) in enumerate(self.pipe_adj):
                u, v = self.node_to_idx[start_node], self.node_to_idx[end_node]
                
                # Assume Q_t[idx] is the flow from start_node to end_node
                if v == i: # Inflow to node i
                    net_flow += Q_t[idx]
                    total_inflow += Q_t[idx] if Q_t[idx] > 0 else 0.0
                elif u == i: # Outflow from node i
                    net_flow -= Q_t[idx]
            
            # Absolute violation
            violation_abs = torch.abs(net_flow - D_t[i])
            
            # Normalized violation
            denominator = total_inflow + EPSILON # Relative form (scaled by typical inflow)
            phi_mass[i] = violation_abs / denominator

        # 2. Energy Gradient Violation (Equation 2)
        phi_energy_max = torch.zeros(N, dtype=P_t.dtype).to(device)

        for idx, (start_node, end_node) in enumerate(self.pipe_adj):
            i, j = self.node_to_idx[start_node], self.node_to_idx[end_node]
            L, D_pipe, C_HW = self.pipe_params[idx]
            
            # Theoretical head loss (H-W)
            h_L_theory = self.hazen_williams_head_loss(Q_t[idx], L, D_pipe, C_HW)
            
            # Measured energy heads
            H_i = P_t[i] + self.elevations[i]
            H_j = P_t[j] + self.elevations[j]
            
            # Energy balance violation: | (H_i - H_j) - h_L |
            violation_abs = torch.abs((H_i - H_j) - h_L_theory)
            
            # Normalized violation (scaled by max energy head)
            denominator = torch.max(H_i, H_j) + EPSILON
            phi_energy_ij = violation_abs / denominator
            
            # Aggregate: max violation across incident pipes (to get node-level feature)
            phi_energy_max[i] = torch.max(phi_energy_max[i], phi_energy_ij)
            phi_energy_max[j] = torch.max(phi_energy_max[j], phi_energy_ij)

        # Final PI features
        return phi_mass, phi_energy_max

    def interpolate_unmeasured(self, features_t, measured_mask):
        """
        Implements pressure-driven interpolation for unmeasured nodes (Section 3.2).
        This is a placeholder and requires hydraulic distance (d_ij) and measured neighbors (N_m)
        which must be pre-calculated based on the WDS structure.
        """
        # Simplification: A real implementation needs EPANET or networkx for d_ij
        unmeasured_indices = torch.where(~measured_mask)[0]
        
        # In a full implementation, this should compute the weighted average:
        # h_t(v_j) = sum_{i in N_m(j)} w_ij * h_t(v_i)
        # w_ij = exp(-d_ij/sigma) / sum_k exp(-d_jk/sigma)
        
        if unmeasured_indices.numel() > 0:
            # Placeholder: using a simpler, but incorrect, local average for structure
            features_t[unmeasured_indices] = features_t[measured_mask].mean(dim=0)
            print("Warning: Interpolation simplified. Needs hydraulic distance d_ij.")
            
        return features_t

# --- 4. MODEL ARCHITECTURE (Physics-GAT) ---

class GATCore(nn.Module):
    """
    Spatial Encoding: L=3 GAT layers (Multi-Head Attention)
    """
    def __init__(self, in_channels, hidden_channels, num_layers, num_heads):
        super(GATCore, self).__init__()
        self.layers = nn.ModuleList()
        
        # Input layer
        self.layers.append(GATConv(in_channels, hidden_channels, heads=num_heads, dropout=0.1))
        
        # Hidden layers
        for _ in range(num_layers - 2):
            self.layers.append(GATConv(hidden_channels * num_heads, hidden_channels, heads=num_heads, dropout=0.1))
            
        # Output layer
        # Output of the last GAT layer (L=3) is for the BiLSTM
        self.layers.append(GATConv(hidden_channels * num_heads, hidden_channels, heads=1, concat=False, dropout=0.1))

    def forward(self, x, edge_index):
        for i, layer in enumerate(self.layers):
            x = layer(x, edge_index)
            if i < len(self.layers) - 1:
                x = F.elu(x) # ELU activation between layers (typical GAT setup)
        return x # Output shape: (N_nodes, hidden_channels)

class PhysicsGAT(nn.Module):
    """
    Combines GAT spatial encoding, BiLSTM temporal fusion, and Multi-Scale Detection.
    """
    def __init__(self, pi_feature_dim, hidden_dim, window_size, num_clusters):
        super(PhysicsGAT, self).__init__()
        
        # Spatio-Temporal Core
        self.gat_core = GATCore(pi_feature_dim, hidden_dim, NUM_GAT_LAYERS, NUM_GAT_HEADS)
        
        # BiLSTM: Input is time-series of GAT embeddings (W, N, D_out) -> (N, W, D_out)
        self.bilstm = nn.LSTM(hidden_dim, hidden_dim, batch_first=True, bidirectional=True)
        # BiLSTM output: 2 * hidden_dim (for bi-directional concatenation)
        
        # Micro-level Detector (MLP)
        self.micro_mlp = nn.Sequential(
            nn.Linear(hidden_dim * 2, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, 1) # Output: micro-level anomaly score (a_t^micro)
        )
        
        # Multi-Scale Fusion Components
        # Louvain clustering is done offline (assumed in data prep)
        self.pooling_transform = nn.Linear(hidden_dim * 2, hidden_dim) # W_pool in Eq 3 text
        self.pooling_vector = nn.Linear(hidden_dim, 1, bias=False) # v in Eq 3 text
        
        # Adaptive Fusion (Lambda weights)
        # Input to Softmax: [std(a_t^micro), max(a_t^meso), a_t^macro] (3-dim vector)
        self.lambda_mlp = nn.Linear(3, 3) # W_lambda

        self.num_clusters = num_clusters
        self.hidden_dim = hidden_dim
        self.window_size = window_size

    def forward(self, features_window, edge_index, cluster_indices):
        """
        :param features_window: Tensor of shape (W, N, F_in)
        :param edge_index: Graph edge index (2, E)
        :param cluster_indices: Tensor (N_nodes,) mapping node index to cluster ID
        """
        W, N, F_in = features_window.shape
        
        # 1. Spatial Encoding (GAT)
        spatial_embeddings = []
        for t in range(W):
            x_t = features_window[t].to(device) # (N, F_in)
            z_t = self.gat_core(x_t, edge_index.to(device)) # (N, D_hidden)
            spatial_embeddings.append(z_t)
        
        # 2. Temporal Fusion (BiLSTM)
        # Reshape for BiLSTM: (N, W, D_hidden)
        z_window = torch.stack(spatial_embeddings, dim=1) # (N, W, D_hidden)
        
        # BiLSTM output: (N, W, 2*D_hidden). We only take the last step of the sequence.
        # Note: Using BiLSTM's output for all steps, then selecting the last:
        bilstm_out, _ = self.bilstm(z_window) # (N, W, 2*D_hidden)
        f_t = bilstm_out[:, -1, :] # (N, 2*D_hidden) -> Fused spatio-temporal features (f_i,t)

        # 3. Multi-Scale Detection
        a_micro = torch.sigmoid(self.micro_mlp(f_t)).squeeze(-1) # (N,)

        # Meso-level Score (Attention Pooling)
        a_meso_list = []
        for c in range(self.num_clusters):
            cluster_mask = (cluster_indices == c)
            if cluster_mask.sum() == 0:
                a_meso_list.append(torch.tensor(0.0).to(device))
                continue
            
            # Cluster features: (N_c, 2*D_hidden)
            f_cluster = f_t[cluster_mask] 
            a_micro_cluster = a_micro[cluster_mask]
            
            # Attention Pooling weights (Eq 3 text)
            # beta_i = exp(v^T * tanh(W_pool * f_i,t)) / sum_j (...)
            attention_logits = self.pooling_vector(torch.tanh(self.pooling_transform(f_cluster))) # (N_c, 1)
            attention_weights = F.softmax(attention_logits, dim=0) # (N_c, 1) -> beta_i
            
            # Weighted average: a_t^meso = sum_i beta_i * a_t^micro(v_i)
            a_meso = (attention_weights.squeeze(-1) * a_micro_cluster).sum()
            a_meso_list.append(a_meso)
            
        a_meso_max = torch.stack(a_meso_list).max() # Max meso score across clusters
        
        # Macro-level Score
        a_macro = a_micro.mean()
        
        # Adaptive Fusion (Section 3.3, Eq 3)
        # Input vector s_t
        s_t = torch.tensor([a_micro.std(), a_meso_max, a_macro], dtype=torch.float32).to(device)
        
        # Lambda weights (Softmax over W_lambda * s_t)
        lambda_weights = F.softmax(self.lambda_mlp(s_t), dim=0)
        lambda_1, lambda_2, lambda_3 = lambda_weights[0], lambda_weights[1], lambda_weights[2]
        
        # Final Score (a_t^final): Requires mapping meso score back to node level
        a_meso_node = torch.zeros_like(a_micro).to(device)
        for c in range(self.num_clusters):
            a_meso_node[cluster_indices == c] = a_meso_list[c]
            
        a_final = lambda_1 * a_micro + lambda_2 * a_meso_node + lambda_3 * a_macro
        
        return a_final, lambda_weights

# --- 5. TRAINING AND LOSS FUNCTIONS ---

def composite_loss(a_final, y_true, pi_mass, pi_energy, edge_index):
    """
    Implements the composite loss L = L_BCE + lambda_p * L_physics + lambda_c * L_consist (Eq 4).
    :param a_final: Tensor of final predicted anomaly scores (N,)
    :param y_true: Tensor of true binary labels (N,)
    :param pi_mass: Tensor of phi_mass features (N,)
    :param pi_energy: Tensor of phi_energy features (N,)
    :param edge_index: Graph edge index (2, E)
    """
    # 1. Binary Cross-Entropy Loss (L_BCE)
    l_bce = F.binary_cross_entropy(a_final, y_true.float())
    
    # 2. Physics Regularization Loss (L_physics) (Eq 5)
    # Penalizes physics violations only during normal operation (y_i,t = 0)
    normal_mask = (y_true == 0)
    
    if normal_mask.sum() > 0:
        # max(phi_mass^i(t), phi_energy^i(t))
        max_pi_violation = torch.max(pi_mass, pi_energy)
        
        # Sum over only normal nodes (y_i,t = 0)
        l_physics = max_pi_violation[normal_mask].mean()
    else:
        l_physics = torch.tensor(0.0).to(device)
        
    # 3. Spatio-Temporal Consistency Loss (L_consist)
    # Enforces |a_i,t - a_j,t|^2 for all connected nodes (i, j) in E
    row, col = edge_index
    score_diff = a_final[row] - a_final[col]
    l_consist = (score_diff ** 2).mean() # Averaged over all edges
    
    # Total Loss (Eq 4)
    total_loss = l_bce + LAMBDA_PHYSICS * l_physics + LAMBDA_CONSIST * l_consist
    
    return total_loss, l_bce, l_physics, l_consist


