            y_t = labels[t].to(device)
            
            a_final, _ = model(features_window, edge_index, cluster_indices)
            
            # Thresholding for F1 calculation (typically 0.5)
            preds = (a_final > 0.5).cpu().numpy()
            targets = y_t.cpu().numpy()
            
            all_preds.extend(preds)
            all_targets.extend(targets)

    final_f1 = f1_score(all_targets, all_preds, average='binary')
    print("\n--- Model Evaluation (Mock Data) ---")
