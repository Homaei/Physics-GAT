            optimizer.zero_grad()
            a_final, _ = model(features_window, edge_index, cluster_indices)
            
            # 3. Loss and Backward Pass
            loss, l_bce, l_physics, l_consist = composite_loss(
                a_final, y_t, pi_mass_t, pi_energy_t, edge_index
            )
            
            loss.backward()
            optimizer.step()
            total_loss += loss.item()

        scheduler.step()
        
        if (epoch + 1) % 5 == 0:
            avg_loss = total_loss / (T_TRAIN - WINDOW_SIZE)
            print(f"Epoch {epoch+1}/{NUM_EPOCHS}, Avg Loss: {avg_loss:.4f}, LR: {optimizer.param_groups[0]['lr']:.6f}")
