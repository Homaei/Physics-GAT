    edge_index = torch.randint(0, N_NODES, (2, 2 * N_PIPES), dtype=torch.long)
    adj_list = defaultdict(list)
    for u, v in edge_index.t().tolist():
        adj_list[f'J{u}'].append(f'J{v}')
        
    cluster_indices = torch.randint(0, NUM_CLUSTERS, (N_NODES,), dtype=torch.long).to(device)
    
    # Initialize PI Feature Generator
    pi_generator = PhysicalConstraintFeatures(node_df, pipe_df, adj_list)
    
    # 2. Load Time-Series Data (BATADAL Training Set)
    # --- ASSUMED TIME SERIES DATA ---
    # raw_features: Tensor (T, N_NODES, F_raw)
    # flow_data: Tensor (T, N_PIPES)
    # demand_estimates: Tensor (T, N_NODES)
    # labels: Tensor (T, N_NODES)
    # --------------------------------
    
    T_TRAIN = 1000 # Mock time steps
    T_TEST = 200
    
    raw_features = torch.randn(T_TRAIN + T_TEST, N_NODES, FEATURE_DIM - 2)
    flow_data = torch.randn(T_TRAIN + T_TEST, N_PIPES)
    demand_estimates = torch.randn(T_TRAIN + T_TEST, N_NODES) * 0.1
    labels = torch.randint(0, 2, (T_TRAIN + T_TEST, N_NODES))
    
    # 3. Feature Preparation: Generating PI Features for all time steps
    all_pi_features = []
    
    for t in range(T_TRAIN + T_TEST):
        # MOCK: P_t must be extracted from raw_features based on column index!
        P_t_mock = raw_features[t, :, 0].to(device) # Assuming Pressure is the first raw feature
        Q_t = flow_data[t].to(device)
        D_t = demand_estimates[t].to(device)
        
        pi_mass_t, pi_energy_t = pi_generator.compute_pi_features(P_t_mock, Q_t, D_t)
        
        # Concatenate raw features with PI features
        full_features_t = torch.cat([raw_features[t].to(device), pi_mass_t.unsqueeze(-1), pi_energy_t.unsqueeze(-1)], dim=-1)
        
        # Handle unmeasured nodes (simplified mock)
        measured_mask = node_df['is_measured'].values # Mock mask (all true for this mock)
